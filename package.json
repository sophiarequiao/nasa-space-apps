{
  "name": "sospesai",
  "version": "0.1.0",
  "description": "SOSpesAI: health and medical-resource companion for astronauts on space missions (NASA Space Apps Challenge 2026, Seville). Not a medical device.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data": "python3 scripts/build_data.py",
    "verify": "node --experimental-strip-types scripts/verify_authority.mjs",
    "typecheck": "tsc --noEmit",
    "licenses": "npx --yes license-checker-rseidelsohn --summary --production"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sophiarequiao/nasa-space-apps.git"
  },
  "keywords": [
    "nasa-space-apps",
    "astronaut",
    "health-monitoring",
    "pwa",
    "three.js"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/sophiarequiao/nasa-space-apps/issues"
  },
  "homepage": "https://github.com/sophiarequiao/nasa-space-apps#readme",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "private": true,
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
